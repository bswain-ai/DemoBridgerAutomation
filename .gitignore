
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Environment — contains personal BASE_DIR paths and live credentials.
# Each team member creates their own local .env from .env.example.
# .env.example IS committed — it is the safe placeholder template.
# .env is NOT committed — it contains real paths and passwords.
.env

# Rater output — generated .xlsm copies produced per test run.
# Large binary files regenerated on every execution — no value in git history.
/RaterOutput/

# Diagnostic screenshots — produced by temporary inspect_*.spec.js scripts.
# These are never needed in version history.
*.png
