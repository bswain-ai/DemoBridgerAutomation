# ─────────────────────────────────────────────────────────────────
# BASE DIRECTORY
# ─────────────────────────────────────────────────────────────────
# All file paths below are expressed as filenames only —
# credentials.js prepends this path at runtime using path.join().
# ─────────────────────────────────────────────────────────────────
BASE_DIR=C:\Users\Biswadeepak Swain\Downloads\BridgerInsurance

# ─────────────────────────────────────────────────────────────────
# RUNTIME STATE SELECTOR
# ─────────────────────────────────────────────────────────────────
# Change this one line to switch the active state.
#
# State Codes:
#   TX = Texas
#   CA = California
#   AZ = Arizona
#
# credentials.js reads STATE and looks up DATA_FILE_{STATE} and
# RATER_FILE_{STATE} — no code changes needed to switch states.
# ─────────────────────────────────────────────────────────────────
STATE=CA

# ─────────────────────────────────────────────────────────────────
# EXECUTION ENVIRONMENT
# ─────────────────────────────────────────────────────────────────
# TEST = Test/UAT Environment
# PROD = Production Environment
# ─────────────────────────────────────────────────────────────────
ENVIRONMENT=TEST

# ─────────────────────────────────────────────────────────────────
# EXECUTION SUITE
# ─────────────────────────────────────────────────────────────────
# ALL         = Execute all test cases
# Smoke       = Execute Smoke suite
# Regression  = Execute Regression suite
# Sanity      = Execute Sanity suite
# Smoke,Regression = Execute multiple suites
# ─────────────────────────────────────────────────────────────────
EXECUTION_SUITE=ALL

# ─────────────────────────────────────────────────────────────────
# STATE-SPECIFIC FILES (filenames only — BASE_DIR prepended at runtime)
# ─────────────────────────────────────────────────────────────────
