# ─────────────────────────────────────────────────────
# BASE DIRECTORY — REQUIRED SETUP FOR EACH TEAM MEMBER
# ─────────────────────────────────────────────────────
# Replace C:/REPLACE_WITH_YOUR_LOCAL_PATH with the
# full path to your local regression suite folder.
#
# Example on Windows:
#   BASE_DIR=C:/Users/JohnSmith/Documents/RegressionSuite
#
# Example on OneDrive:
#   BASE_DIR=C:/Users/JohnSmith/OneDrive/RegressionSuite
#
# DO NOT commit your personal path to git.
# This file (.env) is in .gitignore for this reason.
# Only .env.example is committed to the repo.
# ─────────────────────────────────────────────────────
BASE_DIR=C:/REPLACE_WITH_YOUR_LOCAL_PATH


# ─────────────────────────────────────────────────────
# RUNTIME STATE SELECTOR
# ─────────────────────────────────────────────────────
# Change this one line to switch the active state.
# Must match a DATA_FILE_{STATE} / RATER_FILE_{STATE}
# pair defined below. No code changes needed to switch.
# ─────────────────────────────────────────────────────
STATE=TX


# ─────────────────────────────────────────────────────
# STATE-SPECIFIC FILES
# ─────────────────────────────────────────────────────
# Filenames only — no path prefix.
# BASE_DIR is prepended at runtime by credentials.js.
# To add a new state: add two lines and set STATE above.
# ─────────────────────────────────────────────────────

# TX
DATA_FILE_TX=BridgerAuto_TX_TC_Template_Multi.xlsx
RATER_FILE_TX=RPBG_TX_Eff_10272025_NB_10162025_RN_Multi.xlsm

# CA (uncomment when CA files are ready)
# DATA_FILE_CA=BridgerAuto_CA_TC_Template_Multi.xlsx
# RATER_FILE_CA=RPBG_CA_Eff_..._RN_Multi.xlsm


# ─────────────────────────────────────────────────────
# OUTPUT FILES (shared across all states)
# ─────────────────────────────────────────────────────
# Results always write to the same output files
# regardless of active state.
# BASE_DIR is prepended to these at runtime as well.
# ─────────────────────────────────────────────────────
DATA_RESULT=OutputFile_PolicyUIPrem&RaterPrem.xlsx
RATER_OUTPUT=RaterOutput


# ─────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────
# Replace all values below with your actual credentials.
# NEVER commit real credentials to git.
# ─────────────────────────────────────────────────────
URL=https://REPLACE_WITH_APP_URL/signin?callbackUrl=%2F
AGENT_EMAIL=REPLACE_WITH_AGENT_EMAIL
UW_EMAIL=REPLACE_WITH_UW_EMAIL
PASSWORD=REPLACE_WITH_PASSWORD
